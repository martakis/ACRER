Package: ACRER
Type: Package
Title: Accessibility for Recreation in R
Version: 1.0.1
Date: 2026-09-21
Authors@R: c(
    person("Georgios", "Martakis", email = "georgios.martakis@gmail.com", role = c("aut", "cre")),
    person("Jan", "Bervaes", role = "ctb", comment = "deceased"),
    person("Bert", "van der Werf", role = "ctb", comment = c(ORCID = "0000-0003-3072-5937"))
